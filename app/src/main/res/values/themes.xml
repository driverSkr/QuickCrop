<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.QuickCrop" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 全局默认页面底色设为黑色，覆盖 XML/View 页面和 Compose 挂载前的窗口背景。 -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <!-- 系统栏默认跟随黑色背景，图标/文字使用浅色。 -->
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="QuickCropCountChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_count_chip</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="QuickCropFilterTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_filter_tab_selected</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="QuickCropFilterTabSecondary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_filter_tab_secondary</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">#D9D9D9</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
