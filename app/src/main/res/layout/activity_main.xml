<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_album_panel"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QuickCrop 相册"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="展示设备里的图片和视频，后续可在这里接入新的编辑流程。"
            android:textColor="#B9B9B9"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recent_count"
                style="@style/QuickCropCountChip" />

            <TextView
                android:id="@+id/video_count"
                style="@style/QuickCropCountChip"
                android:layout_marginStart="10dp" />

            <TextView
                android:id="@+id/image_count"
                style="@style/QuickCropCountChip"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_recent"
            style="@style/QuickCropFilterTab"
            android:text="最近" />

        <TextView
            android:id="@+id/tab_video"
            style="@style/QuickCropFilterTab"
            android:layout_marginStart="10dp"
            android:text="视频" />

        <TextView
            android:id="@+id/tab_image"
            style="@style/QuickCropFilterTab"
            android:layout_marginStart="10dp"
            android:text="图片" />

        <TextView
            android:id="@+id/tab_refresh"
            style="@style/QuickCropFilterTabSecondary"
            android:layout_marginStart="10dp"
            android:text="刷新权限" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/media_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_album_panel"
            android:padding="20dp"
            android:text="没有找到内容"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
